# Copiez ce fichier en .env et ajustez les valeurs selon votre environnement.

# Nom de l'application (affiché dans le header)
APP_NAME=TextSense

# Mode debug (true affiche les logs DEBUG dans la console)
DEBUG=false

# URL de la base de données (par défaut : textsense.db à la racine du projet)
# SQLite (chemin absolu conseillé) :
# DATABASE_URL=sqlite:////chemin/absolu/textsense.db
# PostgreSQL (production) — nécessite : pip install "psycopg[binary]"
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/textsense

# Moteur d'inférence du modèle principal : transformers (défaut) ou onnx
# MODEL_BACKEND=transformers

# Modèle Transformers : identifiant du Hub Hugging Face OU dossier local
HF_MODEL_ID=cmarkea/distilcamembert-base-sentiment
# Modèle fine-tuné localement (make finetune) :
# HF_MODEL_ID=models/distilcamembert-3c-starinit-s42

# Modèle ONNX (si MODEL_BACKEND=onnx ; make export-onnx)
# ONNX_MODEL_DIR=models/distilcamembert-3c-starinit-s42-onnx
# ONNX_MODEL_FILE=model.int8.onnx

# Seuil de confiance (0 à 1) sous lequel la prédiction est marquée low_confidence.
# Laisser commenté pour utiliser le seuil calibré enregistré avec le modèle.
# CONFIDENCE_THRESHOLD=0.81

# Longueur maximale en tokens (troncature)
HF_MAX_TOKENS=512

# Pagination de l'historique
HISTORY_DEFAULT_LIMIT=50
HISTORY_MAX_LIMIT=200

# Dossier du modèle fallback sklearn (relatif = depuis la racine du projet)
# MODEL_DIR=saved_models
